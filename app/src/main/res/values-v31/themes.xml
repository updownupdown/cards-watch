<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system splash shows no icon, on Nocturne's night: the app's logo screen (SplashScreen), on the same night, follows at once. -->
    <style name="Theme.Solitarius" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:windowSplashScreenBackground">@color/night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
